# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# OSX
.DS_store

# diags collections
clickhousebook.local/*

# testdata logs
testdata/*

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

.idea
TODO.md
output
vendor
dist/

# Built binaries (do not commit — produced by `make build` / `go build`)
/bin/
clickhouse-diagnostic
clickhouse-diagnostics
clickhouse_diagnostic
clickhouse-diagnostic-*

# Local scripts (connect to private repos — not for public commit)
local/

# Node.js (used by local scripts)
node_modules/
package.json
package-lock.json

# Tool output — produced by every run. Never commit:
#   the archive sent to support contains customer database/table data,
#   the gov-mode mapping CSV is a local-only secret.
clickhouse_results/
clickhouse_backup_*/
clickhouse_backup_*.tar.gz
*_gov_name_mapping.csv
configuration/

# Customer-shipped diagnostic artifacts dropped at the repo root
# (Grafana exports, dashboard JSON, etc.). Anchored with leading `/`
# so legitimate JSON inside subdirectories is unaffected.
/*.json
/*HomeDash*.json
/S2HomeDash*.json
